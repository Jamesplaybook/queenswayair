---
layout: layouts/base.njk
title: "Customer Reviews | Queensway Heating and Cooling"
description: "Read reviews from Queensway Heating and Cooling customers across the GTA, Hamilton, and Niagara — 5/5 from 5 reviews."
---

<section class="page-hero page-hero--photo" aria-label="Customer Reviews">
  <div class="page-hero__bg" aria-hidden="true">
    {% heroImage "/assets/img/hero/reviews.jpg", "Happy GTA homeowner with a Queensway technician", "100vw" %}
  </div>
  <div class="page-hero__overlay" aria-hidden="true"></div>
  <div class="page-hero__content">
    <div class="container">
      <h1>What Our Customers Say</h1>
      <p>Rated {{ site.reviewRating }}/5 from {{ site.reviewCount }} reviews on Google. Here's what your neighbours think of Queensway Heating and Cooling.</p>
    </div>
  </div>
</section>

<section class="section">
  <div class="container" style="max-width:640px;text-align:center;">
    <div class="stars-img" aria-label="{{ site.reviewRating }} stars" role="img" style="justify-content:center;display:flex;margin-bottom:1rem;">
      {% set starSize = 24 %}{% for i in range(0, 5) %}{% include "partials/star.njk" %}{% endfor %}
    </div>
    <p class="lead">Our reviews live on our Google Business Profile — real feedback from real GTA, Hamilton, and Niagara homeowners.</p>

    <div class="review-platforms" style="margin-top:2.5rem;border:none;padding-top:0;">
      <div class="review-platforms__grid" style="grid-template-columns:1fr;max-width:340px;margin:0 auto;">
        <div class="review-platform">
          <img src="/assets/img/brand-marks/google-reviews.svg" alt="Google Reviews" width="140" height="52" loading="lazy">
          <p>{{ site.reviewCount }} Google Reviews</p>
          <a href="{{ site.gbpUrl }}" target="_blank" rel="noopener noreferrer" class="btn btn-outline">View on Google →</a>
        </div>
      </div>
    </div>
  </div>
</section>

{% include "partials/cta-band.njk" %}
